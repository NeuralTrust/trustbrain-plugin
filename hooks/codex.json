{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "sh \"${PLUGIN_ROOT}/hooks/trustbrain.sh\" codex PreCompact",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\hooks\\trustbrain.ps1\" codex PreCompact",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh \"${PLUGIN_ROOT}/hooks/trustbrain.sh\" codex SessionStart",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\hooks\\trustbrain.ps1\" codex SessionStart",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh \"${PLUGIN_ROOT}/hooks/trustbrain.sh\" codex Stop",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\hooks\\trustbrain.ps1\" codex Stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"${PLUGIN_ROOT}/hooks/trustbrain.sh\" codex UserPromptSubmit",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\hooks\\trustbrain.ps1\" codex UserPromptSubmit",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
