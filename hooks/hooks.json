{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/trustbrain.sh\" claude PreCompact",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/trustbrain.sh\" claude SessionEnd",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/trustbrain.sh\" claude SessionStart",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/trustbrain.sh\" claude Stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/trustbrain.sh\" claude UserPromptSubmit",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
